<div class="app-container">
  <h3 class="title">📷 簡易カメラ照度計</h3>
  <div class="lux-display" id="lux-val">---</div>
  <div class="unit">LUX (ルクス)</div>
  <button id="start-btn" onclick="startApp()">測定スタート</button>
  <div id="msg"></div>
</div>

<!-- 裏で処理するための隠し要素 -->
<video id="cam-video" autoplay playsinline muted></video>
<canvas id="cam-canvas"></canvas>

<script>
  const video = document.getElementById('cam-video');
  const canvas = document.getElementById('cam-canvas');
  const ctx = canvas.getContext('2d', { willReadFrequently: true });
  const luxVal = document.getElementById('lux-val');
  const msg = document.getElementById('msg');
  const btn = document.getElementById('start-btn');
  let isRunning = false;

  async function startApp() {
    if (isRunning) return;
    msg.textContent = "カメラを準備中...";
    
    try {
      // 背面カメラを要求
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: 'environment' }
      });
      
      video.srcObject = stream;
      video.onloadedmetadata = () => {
        video.play();
        isRunning = true;
        btn.style.display = 'none'; // ボタンを隠す
        msg.textContent = "";
        analyzeFrame(); // 解析ループ開始
      };
    } catch (err) {
      msg.textContent = "カメラへのアクセスが拒否されたか、利用できません。";
      console.error(err);
    }
  }

  function analyzeFrame() {
    if (!isRunning) return;

    if (video.readyState === video.HAVE_ENOUGH_DATA) {
      // 処理を軽くするため32x32ピクセルに縮小して解析
      canvas.width = 32;
      canvas.height = 32;
      ctx.drawImage(video, 0, 0, 32, 32);
      
      const imgData = ctx.getImageData(0, 0, 32, 32).data;
      let totalLuminance = 0;
      
      for (let i = 0; i < imgData.length; i += 4) {
        const r = imgData[i], g = imgData[i+1], b = imgData[i+2];
        // 人間の目の感度に近い輝度計算（ITU-R BT.709）
        totalLuminance += (0.2126 * r + 0.7152 * g + 0.0722 * b);
      }
      
      // 平均輝度（0〜255）
      const avgLuminance = totalLuminance / (imgData.length / 4);
      
      // 輝度をルクス（照度）の目安に変換する簡易的な計算式
      let lux = Math.pow(avgLuminance / 255, 2.5) * 2000;
      luxVal.textContent = Math.max(1, Math.round(lux));
    }
    
    // 0.2秒ごとに更新（1秒間に約5回）
    setTimeout(() => requestAnimationFrame(analyzeFrame), 200);
  }
</script>

</body>
