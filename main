import SwiftUI
import AVFoundation

@main
struct LuxMeterApp: App {
    var body: some Scene {
        WindowGroup {
            ContentView()
        }
    }
}

// MARK: - UI (画面デザイン)
struct ContentView: View {
    @StateObject private var camera = CameraBrightnessManager()
    
    var body: some View {
        NavigationStack {
            VStack(spacing: 50) {
                
                // iPad向けの大きなメーター表示
                ZStack {
                    Circle()
                        .stroke(lineWidth: 30)
                        .opacity(0.2)
                        .foregroundColor(.blue)
                    
                    Circle()
                        .trim(from: 0.0, to: min(CGFloat(camera.luxValue) / 5000.0, 1.0))
                        .stroke(style: StrokeStyle(lineWidth: 30, lineCap: .round, lineJoin: .round))
                        .foregroundColor(.blue)
                        .rotationEffect(Angle(degrees: 270.0))
                        .animation(.linear(duration: 0.2), value: camera.luxValue)
                    
                    VStack(spacing: 10) {
                        Text("\(camera.luxValue)")
                            .font(.system(size: 100, weight: .bold, design: .rounded))
                            .contentTransition(.numericText())
                        
                        Text("LUX")
                            .font(.title)
                            .foregroundColor(.gray)
                            .fontWeight(.semibold)
                    }
                }
                .frame(width: 400, height: 400)
                .padding()
                
                // コントロールボタン
                if camera.hasPermission {
                    Button(action: {
                        camera.isRunning ? camera.stop() : camera.start()
                    }) {
                        Label(
                            camera.isRunning ? "測定を停止" : "測定を開始",
                            systemImage: camera.isRunning ? "stop.fill" : "play.fill"
                        )
                        .font(.title2.bold())
                        .padding()
                        .frame(width: 250)
                        .background(camera.isRunning ? Color.red : Color.blue)
                        .foregroundColor(.white)
                        .cornerRadius(20)
                        .shadow(radius: 5)
                    }
                } else {
                    Text("カメラへのアクセスを許可してください")
                        .foregroundColor(.red)
                        .font(.headline)
                }
            }
            .navigationTitle("📷 iPad 照度計")
            .onAppear {
                camera.checkPermission()
            }
        }
    }
}

// MARK: - Camera Manager (照度計算ロジック)
class CameraBrightnessManager: NSObject, ObservableObject, AVCaptureVideoDataOutputSampleBufferDelegate {
    @Published var luxValue: Int = 0
    @Published var isRunning = false
    @Published var hasPermission = false
    
    private var captureSession = AVCaptureSession()
    private let videoOutput = AVCaptureVideoDataOutput()
    
    // カメラの権限確認
    func checkPermission() {
        switch AVCaptureDevice.authorizationStatus(for: .video) {
        case .authorized:
            self.hasPermission = true
        case .notDetermined:
            AVCaptureDevice.requestAccess(for: .video) { granted in
                DispatchQueue.main.async {
                    self.hasPermission = granted
                }
            }
        default:
            self.hasPermission = false
        }
    }
    
    // 測定開始
    func start() {
        guard hasPermission, !isRunning else { return }
        DispatchQueue.global(qos: .userInitiated).async {
            self.setupSession()
            self.captureSession.startRunning()
            DispatchQueue.main.async {
                self.isRunning = true
            }
        }
    }
    
    // 測定停止
    func stop() {
        guard isRunning else { return }
        captureSession.stopRunning()
        isRunning = false
    }
    
    // カメラセッションの設定
    private func setupSession() {
        guard captureSession.inputs.isEmpty else { return }
        captureSession.sessionPreset = .vga640x480
        
        guard let camera = AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back),
              let input = try? AVCaptureDeviceInput(device: camera) else { return }
        
        if captureSession.canAddInput(input) {
            captureSession.addInput(input)
        }
        
        videoOutput.setSampleBufferDelegate(self, queue: DispatchQueue(label: "videoQueue"))
        if captureSession.canAddOutput(videoOutput) {
            captureSession.addOutput(videoOutput)
        }
    }
    
    // フレームごとの明るさ解析（EXIFメタデータを利用して軽量化）
    func captureOutput(_ output: AVCaptureOutput, didOutput sampleBuffer: CMSampleBuffer, from connection: AVCaptureConnection) {
        if let metadataDict = CMCopyDictionaryOfAttachments(allocator: nil, target: sampleBuffer, attachmentMode: kCMAttachmentMode_ShouldPropagate) as? [String: Any],
           let exifMetadata = metadataDict["{Exif}"] as? [String: Any],
           let brightnessValue = exifMetadata["BrightnessValue"] as? Double {
            
            // APEX値 (Brightness Value) を Lux (照度) に変換する近似式
            // Lux = 2.5 * 2^Bv
            let lux = 2.5 * pow(2, brightnessValue)
            
            DispatchQueue.main.async {
                // UIがカクつかないように適度に丸める
                self.luxValue = max(0, Int(lux))
            }
        }
    }
}
